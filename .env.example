# Never commit real secrets.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Comma-separated Hyperliquid master wallet addresses to watch.
HL_WHALE_ADDRESSES=0x0000000000000000000000000000000000000000
WATCHLIST_FILE=watchlist.json
DRY_RUN=true
LOG_LEVEL=INFO
# Optional; {coin} is replaced with a URL-encoded Hyperliquid market symbol.
HL_CHART_URL_TEMPLATE=https://app.hyperliquid.xyz/trade/{coin}
# Error notifications use TELEGRAM_CHAT_ID unless a separate chat is configured.
ERROR_NOTIFY_CHAT_ID=
ERROR_NOTIFY_COOLDOWN_SECONDS=300
LOG_FILE=whale_alert_bot.log
LOG_MAX_BYTES=10485760
LOG_BACKUPS=5
